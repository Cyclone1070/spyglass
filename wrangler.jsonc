{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spyglass-web",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "spyglass.hoangmai.dev",
      "custom_domain": true
    }
  ]
}
